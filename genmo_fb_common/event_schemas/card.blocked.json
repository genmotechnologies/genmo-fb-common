{
  "event_type": "card.blocked",
  "version": 1,
  "source_service": "card-service",
  "description": "A parent blocked the child's card for a while; it can be unblocked.",
  "data": {
    "type": "object",
    "required": [
      "card_id",
      "bank_card_id",
      "family_id",
      "child_member_id",
      "child_bank_customer_id",
      "blocked_by_bank_customer_id",
      "blocked_reason",
      "status"
    ],
    "properties": {
      "card_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "bank_card_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "family_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "child_member_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "child_bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "blocked_by_bank_customer_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "blocked_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "blocked",
          "cancelled"
        ]
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "card_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "bank_card_id": "BANK-CARD-1",
      "family_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "child_member_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "child_bank_customer_id": "CUST-C1",
      "blocked_by_bank_customer_id": "CUST-P1",
      "blocked_reason": "Lost at school",
      "status": "blocked"
    }
  ]
}
