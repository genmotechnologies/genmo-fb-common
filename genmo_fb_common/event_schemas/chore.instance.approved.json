{
  "event_type": "chore.instance.approved",
  "version": 1,
  "source_service": "chores-service",
  "description": "A parent approved a chore. Pays the reward once per event_id.",
  "data": {
    "type": "object",
    "required": [
      "instance_id",
      "chore_id",
      "chore_title",
      "family_id",
      "assigned_to_bank_customer_id",
      "approved_by_bank_customer_id",
      "reward_type",
      "reward_amount",
      "reward_points",
      "reward_paid"
    ],
    "properties": {
      "instance_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "chore_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "chore_title": {
        "type": "string"
      },
      "family_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "assigned_to_bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "approved_by_bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "reward_type": {
        "type": "string"
      },
      "reward_amount": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "reward_points": {
        "type": [
          "integer",
          "null"
        ]
      },
      "reward_paid": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "instance_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "chore_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "chore_title": "example",
      "family_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "assigned_to_bank_customer_id": "CUST-P1",
      "approved_by_bank_customer_id": "CUST-P1",
      "reward_type": "example",
      "reward_amount": "50.00",
      "reward_points": 10,
      "reward_paid": true
    }
  ]
}
