{
  "event_type": "budget.threshold.reached",
  "version": 1,
  "source_service": "budgeting-service",
  "description": "A child's budget, overall or for one category, reached 80% or 100% of its amount in a month (BU-03). Sent once per budget, category, threshold and month.",
  "data": {
    "type": "object",
    "required": [
      "bank_customer_id",
      "family_id",
      "budget_id",
      "month",
      "category",
      "threshold",
      "budget_amount",
      "spent",
      "percent_used",
      "currency"
    ],
    "properties": {
      "bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "family_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "budget_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "month": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "category": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "food",
          "fun",
          "shopping",
          "transport",
          "other",
          null
        ]
      },
      "threshold": {
        "type": "integer",
        "minimum": 1
      },
      "budget_amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "spent": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "percent_used": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "bank_customer_id": "CUST-C1",
      "family_id": "11111111-1111-1111-1111-111111111111",
      "budget_id": "22222222-2222-2222-2222-222222222222",
      "month": "2026-11",
      "category": "food",
      "threshold": 80,
      "budget_amount": "500.00",
      "spent": "410.00",
      "percent_used": "82.00",
      "currency": "MRU"
    }
  ]
}
