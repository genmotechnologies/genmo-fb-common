{
  "event_type": "learning.quiz.answered",
  "version": 1,
  "source_service": "learning-service",
  "description": "A learner answered a quiz question (LT-03, GA-05). gamification gives coins for a right answer on the first try (GA-04, its own configurable rule).",
  "data": {
    "type": "object",
    "required": [
      "quiz_id",
      "question_id",
      "lesson_id",
      "bank_customer_id",
      "family_id",
      "audience",
      "correct",
      "first_try",
      "hearts_left",
      "answered_at"
    ],
    "properties": {
      "quiz_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "question_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "lesson_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "family_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "audience": {
        "type": "string",
        "enum": [
          "child",
          "adult"
        ]
      },
      "correct": {
        "type": "boolean"
      },
      "first_try": {
        "type": "boolean"
      },
      "hearts_left": {
        "type": "integer",
        "minimum": 0
      },
      "answered_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "quiz_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "question_id": "0b3e5f0a-2c41-4d0e-9a8b-5b2f6c7d8e90",
      "lesson_id": null,
      "bank_customer_id": "CUST-C1",
      "family_id": "12345678-1234-5678-1234-567812345678",
      "audience": "child",
      "correct": true,
      "first_try": true,
      "hearts_left": 5,
      "answered_at": "2026-11-19T10:00:00+00:00"
    }
  ]
}
