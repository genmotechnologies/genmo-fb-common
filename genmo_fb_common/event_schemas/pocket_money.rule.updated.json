{
  "event_type": "pocket_money.rule.updated",
  "version": 1,
  "source_service": "pocket-money-service",
  "description": "A pocket money rule changed.",
  "data": {
    "type": "object",
    "required": [
      "rule_id",
      "family_id",
      "amount",
      "frequency"
    ],
    "properties": {
      "rule_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "family_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "frequency": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "rule_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "family_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "amount": "50.00",
      "frequency": "example"
    }
  ]
}
