{
  "event_type": "budget.month.kept",
  "version": 1,
  "source_service": "budgeting-service",
  "description": "A child's budget month is over and the child kept the overall budget: spent at most the budget amount, with at least one counted payment (GA-02, C10). Sent once per budget per month, after the month ended in the bank's time zone.",
  "data": {
    "type": "object",
    "required": [
      "bank_customer_id",
      "family_id",
      "budget_id",
      "month",
      "budget_amount",
      "spent",
      "percent_used",
      "currency"
    ],
    "properties": {
      "bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "family_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "budget_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "month": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "budget_amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "spent": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "percent_used": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "bank_customer_id": "CUST-C1",
      "family_id": "11111111-1111-1111-1111-111111111111",
      "budget_id": "22222222-2222-2222-2222-222222222222",
      "month": "2026-11",
      "budget_amount": "500.00",
      "spent": "410.00",
      "percent_used": "82.00",
      "currency": "MRU"
    }
  ]
}
