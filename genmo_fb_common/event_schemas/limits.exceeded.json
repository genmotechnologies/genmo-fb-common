{
  "event_type": "limits.exceeded",
  "version": 1,
  "source_service": "limits-service",
  "description": "A spending check was refused because a limit was reached.",
  "data": {
    "type": "object",
    "required": [
      "bank_customer_id",
      "family_id",
      "category",
      "limit_type",
      "limit_amount",
      "current_usage",
      "requested_amount",
      "available_amount",
      "currency"
    ],
    "properties": {
      "bank_customer_id": {
        "type": "string",
        "minLength": 1
      },
      "family_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
      },
      "category": {
        "type": [
          "string",
          "null"
        ]
      },
      "limit_type": {
        "type": "string"
      },
      "limit_amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "current_usage": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "requested_amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "available_amount": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "bank_customer_id": "CUST-P1",
      "family_id": "6f1b6c64-6d38-4f9e-8e60-0f1f1b0e8f11",
      "category": "example",
      "limit_type": "example",
      "limit_amount": "50.00",
      "current_usage": "50.00",
      "requested_amount": "50.00",
      "available_amount": "50.00",
      "currency": "MRU"
    }
  ]
}
